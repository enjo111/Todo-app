{
    "compilerOptions": {
        "target": "ES6",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "sourceMap": true,
        "strict": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
    "exclude": ["dist", "node_modules"]
}
 